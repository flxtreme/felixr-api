model Form {
  id          String      @id(map: "pk_form_id") @default(uuid()) @map("form_id")
  name        String      @map("name")
  slug        String      @unique @map("slug")
  config      Json        @map("config")
  status      FormStatus  @default(DRAFT) @map("status")
  userId      String      @map("user_id")
  isDeleted   Boolean     @default(false) @map("is_deleted")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")
  createdBy   String?     @map("created_by")
  updatedBy   String?     @map("updated_by")
  deletedBy   String?     @map("deleted_by")
  user        User        @relation(fields: [userId], references: [id], map: "fk_forms_users")
  submissions FormSubmission[]

  @@index([slug], map: "idx_forms_slug")
  @@index([status], map: "idx_forms_status")
  @@index([userId], map: "idx_forms_user_id")
  @@map("forms")
}

model FormSubmission {
  id        String   @id(map: "pk_form_submission_id") @default(uuid()) @map("submission_id")
  formId    String   @map("form_id")
  data      Json     @map("data")
  userId    String?  @map("user_id")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  form      Form     @relation(fields: [formId], references: [id], map: "fk_form_submissions_forms")
  user      User?    @relation(fields: [userId], references: [id], map: "fk_form_submissions_users")

  @@index([formId], map: "idx_form_submissions_form_id")
  @@index([userId], map: "idx_form_submissions_user_id")
  @@index([createdAt], map: "idx_form_submissions_created_at")
  @@map("form_submissions")
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}